+
+/**
+ * Fish Audio's public REST API is deliberately kept separate from the
+ * OpenAI-compatible provider: Fish expects the model in an HTTP header and
+ * calls a saved voice model `reference_id`.
+ */
+export async function fetchFishAudioTTSAudio(text: string, config: TTSConfig): Promise<Uint8Array> {
+  if (!config.fishAudioApiKey) throw new Error("Fish Audio API key is required");
+
+  const body: Record<string, unknown> = {
+    text,
+    format: "mp3",
+    chunk_length: 300,
+    normalize: true,
+    prosody: {
+      speed: config.rate,
+      volume: 0,
+      normalize_loudness: true,
+    },
+  };
+  if (config.fishAudioReferenceId.trim()) {
+    body.reference_id = config.fishAudioReferenceId.trim();
+  }
+
+  const platform = getPlatformService();
+  const response = await platform.fetch("https://api.fish.audio/v1/tts", {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${config.fishAudioApiKey}`,
+      model: config.fishAudioModel || "s2.1-pro-free",
+    },
+    body: JSON.stringify(body),
+  });
+
+  if (!response.ok) throw await buildTTSHttpError("Fish Audio TTS", response);
+  return new Uint8Array(await response.arrayBuffer());
+}
